# ============================================================
# Solar WiFi Weather Station – API Routing
# ============================================================

Options -Indexes

RewriteEngine On
RewriteBase /sws/api

# Authorization-Header weitergeben
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Alte /v1/-Pfade permanent umleiten
RewriteRule ^v1/(.*)$ /sws/api/$1 [R=301,L]

# Altes Admin-Verzeichnis umleiten
RewriteRule ^admin/?$ /sws/api/ [R=301,L]

# Statische Dateien direkt ausliefern
RewriteCond %{REQUEST_URI} \.(css|js|png|jpg|gif|ico|svg|woff2?|bin|txt|yaml|sql)$
RewriteRule ^ - [L]

# Alles andere → index.php (Router)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# ---- Zugriffsschutz ----
# Konfiguration vor direktem Zugriff schützen
<FilesMatch "^(db\.php|auth\.php|credentials\.php|config\.php)$">
  Require all denied
</FilesMatch>

# auth.php, db.php und credentials.php vor Direktzugriff schützen
<FilesMatch "^(auth|db|credentials)\.php$">
	Require all denied
</FilesMatch>

# Service-Account-JSON vor Direktzugriff schützen
<FilesMatch "\.json$">
	Require all denied
</FilesMatch>
